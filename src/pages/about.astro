---
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Haoran Yu" description="About Haoran Yu and links">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/portrait.png"
					alt="got a Perca Trucha at Dec 11, 2025 at Puerto Varas, Chile"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Contact</h2>
				<div class="content">
					<ul class="resume-list">
						<li><strong>Name:</strong> Haoran Yu</li>
						<li><strong>Email:</strong> ryanr@mail.ustc.edu.cn</li>
						<li><strong>Affiliation:</strong> Department of Astronomy, University of Science and Technology of China</li>
						<li><strong>Website:</strong> ryanr549.github.io</li>
					</ul>
				</div>
			</section>
			<section>
				<h2 class="section-title">Research Interests</h2>
				<div class="content">
					<p>baryon cycle, feedback, circumgalactic medium, intergalactic medium</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<ul class="resume-list">
						<li>
							<strong>Bachelor, Astrophysics</strong><br />
							University of Science and Technology of China, Hefei, China | 2019 - 2023
						</li>
						<li>
							<strong>PhD, Astrophysics</strong><br />
							University of Science and Technology of China, Hefei, China | 2023 - present
						</li>
					</ul>
				</div>
			</section>
			<section>
				<h2 class="section-title">Selected Publications</h2>
				<div class="content">
					<ul class="resume-list">
						<li>
							Lyu, C., Yu, H., Wang, E., et al. (2026),
							<em>First Statistical Detection of Mg II-traced Cool Gas Outflows with JWST toward Cosmic Dawn</em>,
							ApJL, 1000(1), L3.
							<a href="https://doi.org/10.3847/2041-8213/ae48ee">DOI</a>
							|
							<a href="https://ui.adsabs.harvard.edu/abs/2026ApJ..1000L...3L">ADS</a>
						</li>
						<li>
							Yu, H., Wang, E., Chen, Z., et al. (2025),
							<em>Stellar feedback drives the baryon deficiency in low-mass galaxies</em>,
							arXiv:2512.05584.
							<a href="https://doi.org/10.48550/arXiv.2512.05584">DOI</a>
							|
							<a href="https://ui.adsabs.harvard.edu/abs/2025arXiv251205584Y">ADS</a>
						</li>
						<li>
							Yu, H., Fan, L., Han, Y., Sun, W., Zhang, Y., Ding, X., and Xue, Y. (2025),
							<em>A New Approach to Constraining Properties of Active Galactic Nucleus Host Galaxies by Combining Image and Spectral Energy Distribution Decomposition: Testing upon the M_BH-M* Relation</em>,
							ApJ, 978(2), 164.
							<a href="https://doi.org/10.3847/1538-4357/ad9aa3">DOI</a>
							|
							<a href="https://ui.adsabs.harvard.edu/abs/2025ApJ...978..164Y">ADS</a>
						</li>
					</ul>
				</div>
			</section>
		</main>

	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.resume-list {
		margin: 0;
		padding-inline-start: 1.25rem;
		display: grid;
		gap: 0.75rem;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
